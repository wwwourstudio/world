# Copy this file to .env.local and fill in your keys

# Required for the AI chat assistant (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Required for Sketchfab 3D model search and download (get one at https://sketchfab.com/settings/password)
SKETCHFAB_API_KEY=your_sketchfab_key_here
